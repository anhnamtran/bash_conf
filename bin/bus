die()
{
	local _ret="${2:-1}"
	test "${_PRINT_HELP:-no}" = yes && print_help >&2
	echo "$1" >&2
	exit "${_ret}"
}

# validators

command()
{
	local _allowed=("shell" "mosh" "create" "delete" "status" "update" "run" "jobs" "push" "pull" "reboot" "sshd" "forward" "api") _seeking="$1"
	for element in "${_allowed[@]}"
	do
		test "$element" = "$_seeking" && echo "$element" && return 0
	done
	die "Value '$_seeking' (of argument '$2') doesn't match the list of allowed values: 'shell', 'mosh', 'create', 'delete', 'status', 'update', 'run', 'jobs', 'push', 'pull', 'reboot', 'sshd', 'forward' and 'api'" 4
}


begins_with_short_option()
{
	local first_option all_short_options='h'
	first_option="${1:0:1}"
	test "$all_short_options" = "${all_short_options/$first_option/}" && return 1 || return 0
}

# THE DEFAULTS INITIALIZATION - POSITIONALS
_positionals=()
_arg_command=
_arg_leftovers=()
# THE DEFAULTS INITIALIZATION - OPTIONALS


print_help()
{
	printf '%s\n' "Interact with home buses more easily"
	printf 'Usage: %s [-h|--help] [--] <command> ... \n' "$0"
	printf '\t%s\n' "<command>: one of the valid commands. Can be one of: 'shell', 'mosh', 'create', 'delete', 'status', 'update', 'run', 'jobs', 'push', 'pull', 'reboot', 'sshd', 'forward' and 'api'"
	printf '\t%s\n' "... : any subcommand for either b5 or shell, ignored otherwise"
	printf '\t%s\n' "-h, --help: Prints help"
	printf '\n%s\n' "$SUB_CMD_HELP"
}


parse_commandline()
{
	_positionals_count=0
	while test $# -gt 0
	do
		_key="$1"
		if test "$_key" = '--'
		then
			shift
			test $# -gt 0 || break
			_positionals+=("$@")
			_positionals_count=$((_positionals_count + $#))
			shift $(($# - 1))
			_last_positional="$1"
			break
		fi
		case "$_key" in
			-h|--help)
				print_help
				exit 0
				;;
			-h*)
				print_help
				exit 0
				;;
			*)
				_last_positional="$1"
				_positionals+=("$_last_positional")
				_positionals_count=$((_positionals_count + 1))
				;;
		esac
		shift
	done
}


handle_passed_args_count()
{
	local _required_args_string="'command'"
	test "${_positionals_count}" -ge 1 || _PRINT_HELP=yes die "FATAL ERROR: Not enough positional arguments - we require at least 1 (namely: $_required_args_string), but got only ${_positionals_count}." 1
}


assign_positional_args()
{
	local _positional_name _shift_for=$1
	_positional_names="_arg_command "
	_our_args=$((${#_positionals[@]} - 1))
	for ((ii = 0; ii < _our_args; ii++))
	do
		_positional_names="$_positional_names _arg_leftovers[$((ii + 0))]"
	done

	shift "$_shift_for"
	for _positional_name in ${_positional_names}
	do
		test $# -gt 0 || break
		eval "$_positional_name=\${1}" || die "Error during argument parsing, possibly an Argbash bug." 1
		shift
	done
}

parse_commandline "$@"
handle_passed_args_count
assign_positional_args 1 "${_positionals[@]}"

# OTHER STUFF GENERATED BY Argbash
# Validation of values
_arg_command="$(command "$_arg_command" "command")" || exit 1


### END OF CODE GENERATED BY Argbash (sortof) ### ])
# [ <-- needed because of Argbash


# Needed because of a b5 bug
export LC_ALL=en_US.UTF-8
BUS="bus-homebus"
BUS_CACHE_DIR="$HOME/.cache/homebus"

b5_run() {
  if ! which b5 &>/dev/null; then
    die 'b5 not installed, most bus operations will not work. Run the following to install the portable version:\ncurl -fS "https://barney-api.infra.corp.arista.io/download/client?system=$(uname -s | tr A-Z a-z)&arch=$(uname -m | sed -e s/x86_64/amd64/ -e s/aarch64/arm64/)" > b5 && chmod 755 b5'
  fi
  b5 bus "$@"
}

_curl() {
  ow curl -L -s "$@"
}

_clear_cache() {
  echo "Clearing bus name cache"
  rm -rf "$BUS_CACHE_DIR"/*
}

_bus_name() {
  local cache endpoint
  cache="$BUS_CACHE_DIR/name"
  endpoint="https://barney-bbm.infra.corp.arista.io/bus"
  if ! [[ -f "$cache" ]] || [[ -z "$(cat $cache)" ]]; then
    mkdir -p "$BUS_CACHE_DIR"
    _curl -X GET ${endpoint} \
      | jq ".[] | select(.owner == \"$USER\" and .nickname == \"homebus\") | .name" | sed -e 's/"//g' > "$cache"
  fi
  cat "$cache"
}

api_run() {
  local method path endpoint name uri request
  if ! which -s ow; then
    die "'ow' needed for API operations with buses"
  fi

  method="$1"
  shift
  path="$@"
  endpoint="https://barney-bbm.infra.corp.arista.io/bus"

  name="$(_bus_name)"
  if [[ -z "$name" ]]; then
    die "No bus found"
  fi

  uri="${endpoint}/$name"
  case "$method" in
    get)
      request="-X GET"
      ;;
    post)
      request="-X POST"
      ;;
    *)
      die "Unsupported method $method"
      ;;
  esac
  if [[ -z "$path" ]]; then
    _curl $request "${uri}"
  else
    _curl $request "${uri}/${path}"
  fi
}

bus_status() {
  set -e
  local api_out status jobs updating update_finished

  api_out=$(api_run get)
  status=$(echo "$api_out" | jq ".status" | sed -e 's/"//g')
  case "$status" in
    Ready|Pending|*NotReady*|Rebooting)
      if [[ "$status" == "Ready" ]]; then
        # Could be updating if an update job is in the job list
        jobs=$(api_run get job)
        updating=$(echo "$jobs" | jq '.[] | select(.["jobType"] == "update")')
        if [[ -n "$updating" ]]; then
          update_finished=$(echo "$jobs" \
                                  | jq '.[] | select(.["jobType"] == "update" and .status == "Complete")')
          if [[ -z "$update_finished" ]]; then
            status="Updating"
          fi
        fi
      elif [[ "$status" =~ .*NotReady.* ]]; then
        status="[k8s] Containers not ready"
      fi
      echo "$status"
      ;;
    null)
      echo "Deleted"
      ;;
  esac
}

_bus_state() {
  local state waited frames frame status
  state="$1"
  waited="off"
  frames=(
    ".  "
    ".. "
    "..."
  )
  frame=0
  status=$(bus_status)
  while ! [[ "$status" =~ $state ]]; do
    status="$(bus_status)"
    echo -en "\rWaiting for bus to be ${state} ($status)${frames[$frame]}"
    ((frame < ${#frames[@]})) && frame=$((frame + 1)) || frame=0
    waited="on"
    sleep 1
  done
  [[ "$waited" = "on" ]] && echo " Done!"
}

_update_ssh_config() {
  local ssh_conf
  ssh_conf="$HOME/.ssh/ssh_config.d/00-arista-bus-ssh.conf"

  _bus_state "Ready"
  echo "Downloading ssh config to $ssh_conf"
  curl -o "$ssh_conf" "https://barney-bbm.infra.corp.arista.io/bus/${USER}/ssh-config?global-config=true&delimiter=-"
}

bus_shell() {
  _bus_state "Ready|Updating"
  ssh "$BUS" "$*"
}

bus_mosh() {
  _bus_state "Ready|Updating"
  mosh "$BUS"
}

bus_create() {
  _clear_cache
  b5_run create --nickname home --topic home --image "code.arista.io/infra/home-bus%bus/eos"
  _update_ssh_config
}

bus_delete() {
  b5_run delete --force --by-nickname home
  _bus_state "Deleted"
  _clear_cache
}

bus_update() {
  _bus_state "Ready"
  echo "Run the following inside the bus itself"
  echo 'sudo dnf distro-sync --disableplugin verifyprovenance --exclude "poppler*" --exclude "EosKernel*"'
}

bus_jobs() {
  _bus_state "Ready|Updating"
  api_run get job
}

bus_push() {
  local src dst
  src="$1"
  dst="$2"
  _bus_state "Ready|Updating"
  rsync -azP "$src" "$BUS:$dst"
}

bus_pull() {
  local src dst
  src="$1"
  dst="$2"
  _bus_state "Ready|Updating"
  rsync -azP "$BUS:$src" "$dst"
}

bus_reboot() {
  read -p "Rebooting bus, this will take several minutes, proceed? [y/N] " do_reboot
  if ! [[ "$do_reboot" = "y" ]]; then
    echo "Aborting."
    die "Aborting."
  fi
  echo "Rebooting bus"
  api_run post reboot
  _bus_state "Ready|Updating"
  _update_ssh_config
  _clear_cache
}

bus_sshd() {
  _update_ssh_config
}

bus_forward() {
  _bus_state "Ready"

  LOG_FILE="/tmp/autossh-$BUS.log"
  PID_FILE="/tmp/autossh-$BUS.pid"
  if [[ -f "$PID_FILE" ]]; then
    AUTOSSH_PID="$(cat "$PID_FILE")"
    if kill -0 "$AUTOSSH_PID" &>/dev/null; then
      echo "Autossh already running, restarting child SSH process instead." | tee -a "$LOG_FILE"
      ssh "$BUS" 'sudo netstat -talnp | grep "8888.*CLOSE_WAIT" | awk "{ print $7 }" | cut -f1 -d/ | uniq | xargs sudo kill -9 &>/dev/null' &>> "$LOG_FILE"
      kill -10 "$AUTOSSH_PID"
      sleep 1
      if ! kill -0 "$AUTOSSH_PID" &>/dev/null; then
        echo "Autossh exited, restarting"
      else
        exit 0
      fi
    fi
  fi

  set -x
  SYMLINK_AUTH_SOCK=1 \
  AUTOSSH_LOGLEVEL=7 \
  AUTOSSH_LOGFILE="$LOG_FILE" \
  AUTOSSH_POLL=30 \
  AUTOSSH_PIDFILE="$PID_FILE" \
    autossh -M0 -f -vvv \
      -o "ServerAliveInterval 10" \
      -o "ServerAliveCountMax 1" \
      -o "ControlMaster=no" \
      -o "SendEnv=SYMLINK_AUTH_SOCK" \
      -o "ExitOnForwardFailure=yes" \
      -R 8888:localhost:22 \
      -A \
      "$BUS"
}

bus_api() {
  api_run "$@"
}

bus_$_arg_command "${_arg_leftovers[@]}"

#  <-- neded because of Argbash
# ] <-- needed because of Argbash
