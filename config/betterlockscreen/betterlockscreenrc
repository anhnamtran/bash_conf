# ~/.config/betterlockscreenrc

# default options
display_on=0
span_image=false
lock_timeout=300
fx_list=()
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color=282C34
wallpaper_cmd="feh --bg-fill"
quiet=false

# default theme
loginbox=282c34
loginshadow=282c34
locktext="$USER"
font="Iosevka:style=Bold"
ringcolor=abb2bf
insidecolor=282c34
separatorcolor=abb2bf
ringvercolor=61afef
insidevercolor=282c34
ringwrongcolor=e06c75
insidewrongcolor=282c34
timecolor=abb2bf
time_format="%H:%M:%S"
greetercolor=abb2bf
layoutcolor=abb2bf
keyhlcolor=282c34
bshlcolor=e06c75
veriftext="Verifying..."
verifcolor=abb2bf
wrongtext="Failure!"
wrongcolor=e06c75
modifcolor=e06c75
bgcolor=282c34


